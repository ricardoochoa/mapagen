Package: mapagen
Title: Agentic Spatial Toolbox for Analysis and Visualization in R
Version: 0.2.0
Authors@R: c(
    person("Ricardo", "Ochoa Sosa", 
           email = "ricardo.ochoa@capsus.mx", 
           role = c("aut", "cre"),
           comment = c(affiliation = "CAPSUS")),
    person("Socorro", "Román Moro", 
